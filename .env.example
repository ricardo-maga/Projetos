# URL pública ou local da aplicação.
APP_URL="http://localhost:3000"

# Supabase: configurar valores do ambiente de destino.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Segredo exclusivo do servidor. Nunca usar em variáveis NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=""
# Apenas se um proxy próprio definir e limpar X-Real-IP antes da app.
TRUST_PROXY_IP_HEADERS="false"
API_REQUIRE_WRITE_PRECONDITION="false"
API_PROJECT_RLS_READ="false"
# Definir apenas uma data de retirada acordada e origens autorizadas das integrações browser.
API_LEGACY_SUNSET=""
API_INTEGRATION_CORS_ORIGINS=""

# Bootstrap administrativo: manter desativado em operação normal.
ERP_BOOTSTRAP_ADMIN_EMAIL=""
ERP_BOOTSTRAP_SECRET=""
ERP_BOOTSTRAP_ENABLED="false"
